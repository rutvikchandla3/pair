{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "preview:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "testflight": {
      "extends": "production",
      "env": {
        "T3CODE_MOBILE_VERSION": "3.0.0"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "SOURCEMAP_FILE": "/tmp/t3code-ios-main.jsbundle.map"
      },
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "pair-production": {
      "extends": "production",
      "env": {
        "T3CODE_IOS_BUNDLE_ID": "PAIR_IOS_BUNDLE_ID_PLACEHOLDER",
        "T3CODE_IOS_TEAM_ID": "PAIR_APPLE_TEAM_ID_PLACEHOLDER",
        "T3CODE_ANDROID_PACKAGE": "PAIR_ANDROID_PACKAGE_PLACEHOLDER",
        "T3CODE_EAS_PROJECT_ID": "PAIR_EAS_PROJECT_ID_PLACEHOLDER",
        "T3CODE_EAS_OWNER": "PAIR_EAS_OWNER_PLACEHOLDER"
      }
    }
  },
  "submit": {
    "testflight": {
      "extends": "production"
    },
    "production": {
      "ios": {
        "ascAppId": "6787819824"
      },
      "android": {
        "track": "internal"
      }
    },
    "pair-production": {
      "ios": {
        "ascAppId": "PAIR_ASC_APP_ID_PLACEHOLDER"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
